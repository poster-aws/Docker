  <header>
    <div class="menu-icon" onclick="toggleMenu()">&#9776;</div>
    <span>Здесь надпись на полосе</span>

    <div class="switch-wrapper">
      <label class="neon-switch" id="neonSwitch">
        <input type="checkbox" id="toggle" onchange="updateLabels()">
        <span class="neon-slider"></span>
      </label>
      <div class="switch-labels">
        <span id="labelOrder">Order</span>
        <span id="labelNimport">N'import</span>
      </div>
    </div>
  </header>






  // Установить состояние переключателя по URL
  window.onload = function () {
    const urlParams = new URLSearchParams(window.location.search);
    const order = urlParams.get('order') || '1';
    const toggle = document.getElementById("toggle");
    toggle.checked = (order === '0');
    updateLabels();
  }

  function updateLabels() {
    const toggle = document.getElementById("toggle");
    const isChecked = toggle.checked;

    document.getElementById("labelOrder").classList.toggle("active", !isChecked);
    document.getElementById("labelNimport").classList.toggle("active", isChecked);
    document.getElementById("neonSwitch").classList.toggle("active", isChecked);

    window.location.href = "?order=" + (isChecked ? 0 : 1);
  }