-------- Процедура для первоначального создания Q2_stats_norder --------
-------- Перешитывает полностью всю таблицу Q2_stats_norder --------
-------- Порядок не важен / Dans n'emport quel Order -------- 

-------- первая команда  добавление процедуры в БД --------

DELIMITER //

CREATE PROCEDURE fill_Q2_stats_norder_full()
BEGIN
    DECLARE total INT DEFAULT 0;
    DECLARE i INT DEFAULT 0;
    DECLARE d DATE;
    DECLARE a INT;
    DECLARE b INT;
    DECLARE min_ab INT;
    DECLARE max_ab INT;

-- создание таблицы
DROP TABLE IF EXISTS Q2_stats_norder;
CREATE TABLE Q2_stats_norder (
    Tirage DATE,
    n1 TINYINT UNSIGNED,
    n2 TINYINT UNSIGNED,
    days INT,
    days2 INT,
    fois INT,
    max INT
);
    -- количество записей
    SELECT COUNT(*) INTO total FROM Q2;

    WHILE i < total DO
        -- получаем i-ю строку с оригинальным порядком чисел
        SELECT Tirage, n1, n2 INTO d, a, b
        FROM Q2
        ORDER BY Tirage
        LIMIT 1 OFFSET i;

        -- для расчётов используем упорядоченные значения
        SET min_ab = LEAST(a, b);
        SET max_ab = GREATEST(a, b);

        -- вставляем строку
        INSERT INTO Q2_stats_norder (Tirage, n1, n2, days, days2, fois, max)
        SELECT 
            d,
            a,
            b,

            -- days
            IFNULL(DATEDIFF(d, (
                SELECT MAX(Tirage) FROM Q2
                WHERE Tirage < d 
                  AND LEAST(n1, n2) = min_ab
                  AND GREATEST(n1, n2) = max_ab
            )), 0),

            -- days2
            IFNULL(DATEDIFF((
                SELECT MAX(Tirage) FROM Q2
                WHERE Tirage < (
                    SELECT MAX(Tirage) FROM Q2
                    WHERE Tirage < d
                      AND LEAST(n1, n2) = min_ab
                      AND GREATEST(n1, n2) = max_ab
                )
                  AND LEAST(n1, n2) = min_ab
                  AND GREATEST(n1, n2) = max_ab
            ), (
                SELECT MAX(Tirage) FROM Q2
                WHERE Tirage < d
                  AND LEAST(n1, n2) = min_ab
                  AND GREATEST(n1, n2) = max_ab
            )), 0),

            -- fois
            IFNULL((
                SELECT COUNT(*) FROM Q2
                WHERE Tirage <= d 
                  AND LEAST(n1, n2) = min_ab
                  AND GREATEST(n1, n2) = max_ab
            ), 0),

            -- max
            IFNULL((
                SELECT MAX(DATEDIFF(Tirage, prev_Tirage)) FROM (
                    SELECT Tirage,
                           LAG(Tirage) OVER (
                               PARTITION BY LEAST(n1, n2), GREATEST(n1, n2)
                               ORDER BY Tirage
                           ) AS prev_Tirage
                    FROM Q2
                    WHERE Tirage <= d
                      AND LEAST(n1, n2) = min_ab
                      AND GREATEST(n1, n2) = max_ab
                ) AS temp
                WHERE prev_Tirage IS NOT NULL
            ), 0);

        SET i = i + 1;
    END WHILE;
END //

DELIMITER ;

-------- вызов процедуры --------

CALL fill_Q2_stats_norder();